# Copy to .env (next to the compose files) and adjust. Every setting is optional
# except POSTGRES_PASSWORD, which compose.postgres.yml needs.

# The address your devices use; goes into the companion app's pairing QR code.
PUBLIC_URL=https://vigortally.your-tailnet.ts.net

# The port on the host.
VIGORTALLY_PORT=8080

# Time zone of the server, e.g. Europe/Berlin.
TZ=UTC

# Only for compose.postgres.yml.
POSTGRES_PASSWORD=change-me
