{
  "name": "@vigortally/server",
  "version": "1.0.0",
  "private": true,
  "description": "VigorTally API server",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "build": "node build.mjs",
